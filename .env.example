# ================================================================
# FreshKeeper — Variables de entorno
# ================================================================
# Copia este archivo a `.env` y rellena los valores reales.
# El archivo `.env` NO se sube a git (ya está en .gitignore vía *.local).
# ================================================================

# --- Google Analytics 4 ---------------------------------------------------
# Obtén tu Measurement ID en https://analytics.google.com (propiedad GA4).
# Si dejas este valor vacío, la landing sigue funcionando y los eventos se
# registran en el event bus local (útil para demo / debugging).
VITE_GA_MEASUREMENT_ID=G-2EZ1YVF0E4

# --- URL del MVP embebido -------------------------------------------------
# El botón "Lanzar demo" carga esta URL dentro de un iframe.
# En desarrollo local, arranca el MVP aparte:
#     cd MVP/PMC && npm install && npm run dev
# Por defecto Vite levanta en http://localhost:5173.
# En producción, usa el dominio donde hayas desplegado el MVP.
VITE_MVP_URL=https://pmc-dusky.vercel.app/
