# ================================================================
# FreshKeeper - Variables de entorno
# ================================================================
# Copia este archivo a `.env` y rellena los valores reales.
# El archivo `.env` NO se sube a git.
# ================================================================

# --- Google Analytics 4 ---------------------------------------------------
# Obten tu Measurement ID en https://analytics.google.com (propiedad GA4).
# Si dejas este valor vacio, la landing sigue funcionando y los eventos se
# registran solo en el event bus local (util para demo / debugging).
VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# --- URL del MVP embebido -------------------------------------------------
# El boton "Lanzar demo" carga esta URL dentro de un iframe.
# En produccion: https://pmc-dusky.vercel.app/
# En desarrollo local del MVP: http://localhost:5173
VITE_MVP_URL=https://pmc-dusky.vercel.app/
